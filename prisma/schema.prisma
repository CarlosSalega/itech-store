// Prisma 7: the client is generated into the repository and consumed from
// there, so the output path is mandatory and relative to this schema directory.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum Category {
  IPHONE
  MAC
  IPAD
  WATCH
  AIRPODS
  ACCESSORY
}

enum Role {
  CUSTOMER
  ADMIN
}

/// The checkout vocabulary verbatim: the stored value is the domain string, so
/// no lookup table stands between a row and the screen.
enum OrderPayment {
  transfer
  cash
}

enum OrderStatus {
  nuevo
  en_preparacion @map("en preparación")
  enviado
  entregado
  cancelado
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  category    Category
  specs       Json?
  /// Editorial flag for the landing: no admin panel exists yet to toggle it.
  featured    Boolean   @default(false)
  /// Every catalogue row is live today, so the default preserves the public catalogue.
  published   Boolean   @default(true)
  variants    Variant[]
  gallery     ProductImage[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  position  Int
  alt       String
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  storage   String?
  color     String?
  /// Price in integer cents (ARS). Money never uses floating point.
  price     Int
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, storage, color])
  @@index([productId])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  imageUploads  ImageUpload[]
  orders        Order[]
  cartItems     CartItem[]
}

/// Every asset the app owns, recorded by the image-upload module so an
/// orphaned asset stays findable after its owner is gone.
model ImageUpload {
  id        String   @id @default(cuid())
  /// Provider key. Unique, so one row per stored asset.
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Order {
  id              String      @id @default(cuid())
  number          String      @unique
  status          OrderStatus @default(nuevo)
  payment         OrderPayment
  buyerName       String
  buyerEmail      String
  buyerPhone      String
  buyerAddress    String
  buyerCity       String
  buyerPostalCode String
  userId          String?
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Total in integer cents (ARS), recomputed from the lines.
  totalCents      Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  lines           OrderLine[]

  @@index([status])
  @@index([createdAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName    String
  productSlug    String
  familyLabel    String
  variantSku     String
  variantLabel   String?
  quantity       Int
  /// Unit price in integer cents (ARS), snapshotted at purchase time.
  unitPriceCents Int
  imageUrl       String?
  imageAlt       String

  @@index([orderId])
}

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([userId, variantId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
