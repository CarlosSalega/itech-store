// Prisma 7: the client is generated into the repository and consumed from
// there, so the output path is mandatory and relative to this schema directory.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "postgresql"
}

enum Category {
  IPHONE
  MAC
  IPAD
  WATCH
  AIRPODS
  ACCESSORY
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  category    Category
  images      String[]
  specs       Json?
  variants    Variant[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  storage   String?
  color     String?
  /// Price in integer cents (ARS). Money never uses floating point.
  price     Int
  stock     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, storage, color])
  @@index([productId])
}
